# Copy to .env to override defaults. All values are optional.

# Preferred port. If it's taken, the launcher tries the next ports (5181, 5182, ...).
# Default comes from package.json "config.port" (5180).
# PORT=5180

# Interface to bind. Keep 127.0.0.1: the app reads local folders and must not be exposed to the network.
# HOST=127.0.0.1

# Where the SQLite database lives (default: ./data).
# DATA_DIR=./data

# Set to "none" to stop the launcher from opening a browser.
# BROWSER=none
