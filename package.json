{
  "name": "projectmanager",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first workspace for persistent AI coding CLI sessions across projects and agent harnesses, with mobile LAN access, terminal panes, task boards and code stats.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "config": {
    "port": 5180
  },
  "scripts": {
    "launch": "node scripts/launch.mjs",
    "owner:pages": "node scripts/owner-pages.mjs",
    "dev": "node scripts/launch.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/launch.mjs --prod",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "bench": "node scripts/benchmark-app.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "jsqr": "^1.4.0",
    "marked": "15.0.12",
    "motion": "^14.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
